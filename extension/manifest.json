{
  "manifest_version": 3,
  "name": "Status Tracker",
  "version": "0.1.0",
  "description": "Chrome extension popup to log and track placement preparation tasks.",
  "permissions": [
    "storage"
  ],
  "host_permissions": [
    "https://statustrackerextension-backend.onrender.com/*"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  }
}